---
import { client } from "../lib/microcms";
import type { Page } from "../lib/microcms";
import type { TocItem } from "../lib/toc";
import "normalize.css";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  toc?: TocItem[];
  showSidebar?: boolean;
  ogType?: "website" | "article";
  page?: Page;
}

const {
  title,
  description = "lab.takeno.tech - 技術的なメモやレポートの置き場",
  toc,
  showSidebar = true,
  ogType = "article",
  page,
} = Astro.props;

// 現在のパスを取得
const pathname = Astro.url.pathname;
const currentPath = pathname.replace(/\/$/, "") || "/";

// OGP画像のパスを決定
const ogImageRelativePath = currentPath === "/" ? "/og/index.png" : `/og${currentPath}.png`;
const ogImageUrl = new URL(ogImageRelativePath, Astro.site).toString();

const siteName = "lab.takeno.tech";
const fullTitle = title === "Home" ? siteName : `${title} | ${siteName}`;
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <title>{fullTitle}</title>
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />

    <!-- OGP -->
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Kode+Mono:wght@400..700&family=Noto+Sans+JP:wght@400..900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    {
      showSidebar && (
        <button
          id="open-sidebar"
          class="icon-btn open-btn"
          aria-label="Open menu"
        >
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <>
              <line x1="3" y1="12" x2="21" y2="12" />
              <line x1="3" y1="6" x2="21" y2="6" />
              <line x1="3" y1="18" x2="21" y2="18" />
            </>
          </svg>
        </button>
      )
    }
    <div class={showSidebar ? "container" : "container no-sidebar"}>
      <div id="sidebar-overlay" class="sidebar-overlay"></div>

      <div class="header-area">
        <slot name="header" />
      </div>

      <div class="main-layout">
        <main class="content">
          <slot />
        </main>

        {
          showSidebar && (
            <div class="sidebar-wrapper">
              <div class="sidebar-controls">
                <a href="/" class="icon-btn control-btn" aria-label="Home">
                  <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <>
                      <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                      <polyline points="9 22 9 12 15 12 15 22" />
                    </>
                  </svg>
                </a>
                <button
                  id="copy-link"
                  class="icon-btn control-btn"
                  aria-label="Copy link"
                >
                  <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <>
                      <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
                      <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
                    </>
                  </svg>
                </button>
                <button
                  id="toggle-sidebar"
                  class="icon-btn control-btn"
                  aria-label="Toggle focus mode"
                >
                  <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <>
                      <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
                      <line x1="15" y1="3" x2="15" y2="21" />
                    </>
                  </svg>
                </button>
              </div>

              <aside class="sidebar" id="sidebar">
                <div class="sidebar-header">
                  <button
                    id="close-sidebar"
                    class="icon-btn"
                    aria-label="Close menu"
                  >
                    <svg
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <>
                        <line x1="18" y1="6" x2="6" y2="18" />
                        <line x1="6" y1="6" x2="18" y2="18" />
                      </>
                    </svg>
                  </button>
                </div>
                <nav>
                  {/* Section：メタ情報の表示 */}
                  {page && (
                    <section class="nav-section meta-section">
                      <div class="nav-section-title">Meta</div>
                      <div class="meta-group">
                        <div class="meta-item">
                          <span class="meta-label">Type</span>
                          <span class="meta-value">
                            {page.type.map((t) => t.toUpperCase()).join(", ")}
                          </span>
                        </div>
                        {page.category && (
                          <div class="meta-item">
                            <span class="meta-label">Category</span>
                            <span class="meta-value">{page.category.name}</span>
                          </div>
                        )}
                        <div class="meta-item">
                          <span class="meta-label">Updated</span>
                          <span class="meta-value">
                            {new Date(page.updatedAt).toLocaleDateString(
                              "ja-JP",
                              {
                                year: "numeric",
                                month: "2-digit",
                                day: "2-digit",
                              },
                            )}
                          </span>
                        </div>
                      </div>
                    </section>
                  )}

                  {/* Section：目次の表示 */}
                  {toc && toc.length > 0 && (
                    <section class="nav-section toc-section">
                      <div class="nav-section-title">ToC</div>
                      <ul class="nav-group toc-list">
                        {toc.map((h2) => (
                          <li>
                            {h2.children.length > 0 ? (
                              <details>
                                <summary>
                                  <a href={`#${h2.id}`}>{h2.text}</a>
                                </summary>
                                <ul>
                                  {h2.children.map((h3) => (
                                    <li>
                                      <a href={`#${h3.id}`}>{h3.text}</a>
                                      {h3.children.length > 0 && (
                                        <ul class="toc-sub">
                                          {h3.children.map((h4) => (
                                            <li>
                                              <a href={`#${h4.id}`}>
                                                {h4.text}
                                              </a>
                                            </li>
                                          ))}
                                        </ul>
                                      )}
                                    </li>
                                  ))}
                                </ul>
                              </details>
                            ) : (
                              <a href={`#${h2.id}`}>{h2.text}</a>
                            )}
                          </li>
                        ))}
                      </ul>
                    </section>
                  )}

                  <section class="nav-section profile-section">
                    <div class="nav-section-title">Profile</div>
                    <a href="/profile" class="profile-content">
                      <img
                        src="/Takeno.png"
                        alt="Takeno"
                        class="profile-icon"
                      />
                      <span class="profile-name">Takeno</span>
                    </a>
                  </section>
                </nav>
              </aside>
            </div>
          )
        }
      </div>

      <footer class="footer">
        {/* フッター要素は今後追加 */}
      </footer>
    </div>

    <script>
      const sidebar = document.getElementById("sidebar");
      const openBtn = document.getElementById("open-sidebar");
      const toggleBtn = document.getElementById("toggle-sidebar");
      const closeBtn = document.getElementById("close-sidebar");
      const copyBtn = document.getElementById("copy-link");
      const overlay = document.getElementById("sidebar-overlay");

      const checkButtonVisibility = () => {
        const scrollPos = window.scrollY;
        const windowHeight = window.innerHeight;
        const bodyHeight = document.documentElement.scrollHeight;

        // 100px以上スクロールしたか、ページが短くてスクロールできないか、最下部に近い場合
        const shouldShow =
          scrollPos > 100 ||
          bodyHeight <= windowHeight ||
          windowHeight + scrollPos >= bodyHeight - 50;
        openBtn?.classList.toggle("show", shouldShow);
      };

      const toggleFocus = () => {
        document
          .querySelector(".container")
          ?.classList.toggle("sidebar-collapsed");
      };

      const openSidebar = () => {
        sidebar?.classList.add("active");
        overlay?.classList.add("active");
      };

      const closeSidebar = () => {
        sidebar?.classList.remove("active");
        overlay?.classList.remove("active");
      };

      const copyUrl = async () => {
        try {
          await navigator.clipboard.writeText(window.location.href);
          const originalColor = copyBtn!.style.color;
          copyBtn!.style.color = "var(--text-accent)";
          setTimeout(() => {
            copyBtn!.style.color = originalColor;
          }, 2000);
        } catch (err) {
          console.error("Failed to copy: ", err);
        }
      };

      openBtn?.addEventListener("click", openSidebar);
      toggleBtn?.addEventListener("click", toggleFocus);
      closeBtn?.addEventListener("click", closeSidebar);
      overlay?.addEventListener("click", closeSidebar);
      copyBtn?.addEventListener("click", copyUrl);

      // スクロール、リサイズ、読み込み時に表示状態をチェック
      window.addEventListener("scroll", checkButtonVisibility, {
        passive: true,
      });
      window.addEventListener("resize", checkButtonVisibility);

      // 初期実行
      checkButtonVisibility();
    </script>
  </body>
</html>

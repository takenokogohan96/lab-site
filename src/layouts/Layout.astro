---
import { client } from "../lib/microcms";
import type { Page } from "../lib/microcms";
import type { TocItem } from "../lib/toc";
import { Image } from "astro:assets";
import profileImage from "../assets/images/profile.png";
import "normalize.css";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  toc?: TocItem[];
  showSidebar?: boolean;
  ogType?: "website" | "article";
  page?: Page;
}

const {
  title,
  description = "lab.takeno.tech",
  toc,
  showSidebar = true,
  ogType = "article",
  page,
} = Astro.props;

// ページ固有のOGP画像（カテゴリのアクセントカラー付き）を使用
const ogImageRelativePath = page?.slug
  ? `/og/${page.slug}.png`
  : "/og/index.png";
const ogImageUrl = new URL(ogImageRelativePath, Astro.site).toString();

const siteName = "lab.takeno.tech";
const fullTitle = title === "Home" ? siteName : `${title} - ${siteName}`;
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <title>{fullTitle}</title>
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#99a8ff" />
    <meta name="description" content={description} />

    <!-- OGP -->
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Kode+Mono:wght@400..700&family=Noto+Sans+JP:wght@400..900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class={showSidebar ? "container" : "container no-sidebar"}>
      <div class="header-area">
        <slot name="header" />
      </div>

      <div class="main-layout">
        <main class="content">
          <slot />
        </main>

        {
          showSidebar && (
            <div class="sidebar-wrapper">
              <div class="sidebar-controls">
                <button
                  id="toggle-sidebar"
                  class="icon-btn control-btn"
                  data-tooltip="サイドバーを閉じる"
                >
                  <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
                    <line x1="15" y1="3" x2="15" y2="21" />
                  </svg>
                </button>
                <button
                  id="copy-link"
                  class="icon-btn control-btn"
                  data-tooltip="リンクをコピーする"
                >
                  <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
                    <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
                  </svg>
                </button>
              </div>

              <aside class="sidebar" id="sidebar">
                <nav>
                  {/* 記事の詳細情報（メタデータ + 目次） */}
                  {/* 目次セクション */}
                  {toc && toc.length > 0 && (
                    <section class="nav-section article-info-section">
                      <div class="nav-section-title">Contents</div>
                      <ul class="nav-group toc-list">
                        {toc.map((h2) => (
                          <li>
                            {h2.children.length > 0 ? (
                              <details>
                                <summary>
                                  <a href={`#${h2.id}`}>{h2.text}</a>
                                </summary>
                                <ul>
                                  {h2.children.map((h3) => (
                                    <li>
                                      <a href={`#${h3.id}`}>{h3.text}</a>
                                      {h3.children.length > 0 && (
                                        <ul class="toc-sub">
                                          {h3.children.map((h4) => (
                                            <li>
                                              <a href={`#${h4.id}`}>
                                                {h4.text}
                                              </a>
                                            </li>
                                          ))}
                                        </ul>
                                      )}
                                    </li>
                                  ))}
                                </ul>
                              </details>
                            ) : (
                              <a href={`#${h2.id}`}>{h2.text}</a>
                            )}
                          </li>
                        ))}
                      </ul>
                    </section>
                  )}

                  <section class="nav-section profile-section">
                    <a href="https://takeno.tech" class="profile-content" target="_blank" rel="noopener noreferrer">
                      <Image
                        src={profileImage}
                        alt="Takeno"
                        width={64}
                        height={64}
                        class="profile-icon"
                      />
                      <div class="profile-info">
                        <span class="profile-name">Takeno</span>
                        <span class="profile-bio">Coffee is Oishii.</span>
                      </div>
                    </a>
                  </section>
                </nav>
              </aside>
            </div>
          )
        }
      </div>

      <footer class="footer">
        <p>
          &copy; 2026 <a href="/">lab.takeno.tech</a> | Created by <a
            href="https://takeno.tech" target="_blank" rel="noopener noreferrer">Takeno</a
          >
        </p>
      </footer>
    </div>

    <script>
      const toggleBtn = document.getElementById("toggle-sidebar");
      const copyBtn = document.getElementById("copy-link");

      const toggleFocus = () => {
        const container = document.querySelector(".container");
        container?.classList.toggle("sidebar-collapsed");

        if (toggleBtn) {
          const isCollapsed =
            container?.classList.contains("sidebar-collapsed");
          toggleBtn.setAttribute(
            "data-tooltip",
            isCollapsed ? "サイドバーを開く" : "サイドバーを閉じる",
          );
        }
      };

      const copyUrl = async () => {
        try {
          await navigator.clipboard.writeText(window.location.href);
          const originalColor = copyBtn!.style.color;
          const originalTooltip = copyBtn!.getAttribute("data-tooltip");
          const originalIcon = copyBtn!.innerHTML;

          copyBtn!.style.color = "#A8FFA8";
          copyBtn!.setAttribute("data-tooltip", "コピーしました");
          copyBtn!.innerHTML = `
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
          `;

          setTimeout(() => {
            copyBtn!.style.color = originalColor;
            copyBtn!.innerHTML = originalIcon;
            if (originalTooltip) {
              copyBtn!.setAttribute("data-tooltip", originalTooltip);
            }
          }, 2000);
        } catch (err) {
          console.error("Failed to copy: ", err);
        }
      };

      toggleBtn?.addEventListener("click", toggleFocus);
      copyBtn?.addEventListener("click", copyUrl);

      // コード/コードブロックのコピー機能
      const copyableElements = document.querySelectorAll("pre, code");
      copyableElements.forEach((el) => {
        // preの中にあるcodeタグは除外（二重発火防止）
        if (el.tagName === "CODE" && el.parentElement?.tagName === "PRE")
          return;

        el.addEventListener("click", async () => {
          try {
            const text = el.textContent || "";
            await navigator.clipboard.writeText(text);

            el.classList.add("copied");
            setTimeout(() => {
              el.classList.remove("copied");
            }, 2000);
          } catch (err) {
            console.error("Failed to copy: ", err);
          }
        });
      });
    </script>
  </body>
</html>

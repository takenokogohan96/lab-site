---
import Layout from "../layouts/Layout.astro";
import { client, formatColor } from "../lib/microcms";
import type { ProfileLink } from "../lib/microcms";
import { Image } from "astro:assets";
import profileImage from "../assets/images/profile.png";

const response = await client.get({
  endpoint: "profilelink",
  queries: { orders: "sortOrder" },
});
const links = response.contents as ProfileLink[];
---

<Layout title="Profile" showSidebar={false} ogType="website">
  <div class="hero">
    <h1>Profile</h1>
  </div>

  <div class="profile-container">
    {/* 左カラム: プロフィール + 自己紹介 */}
    <div class="profile-left-column">
      <section class="profile-main">
        <div class="profile-card">
          <Image
            src={profileImage}
            alt="Takeno"
            width={80}
            height={80}
            class="profile-avatar"
          />
          <div class="profile-details">
            <h2 class="display-name">Takeno</h2>
            <div class="bio-short">
              <p>
                <a
                  href="https://www.google.com/search?q=INFJ"
                  target="_blank"
                  rel="noopener noreferrer">INFJ</a
                > /
                <span style="color: #99A8FF;">#99A8FF</span>
              </p>
            </div>
          </div>
        </div>
      </section>

      <section class="self-introduction">
        <div class="intro-content">
          <p>
            💻 機材 / 🌐 自宅サーバ
            <br />
            📜 資格 / 🚲 サイクリング
            <br />
            🕹 Gran Turismo / ✨ IM@S
            <br />
          </p>
        </div>
      </section>
    </div>

    {/* 右カラム: リンク */}
    <section class="profile-links">
      <div class="link-grid">
        {
          links.map((link) => (
            <a
              href={link.url}
              class="link-button"
              target="_blank"
              rel="noopener noreferrer"
              style={
                link.color ? { "--accent-color": formatColor(link.color) } : {}
              }
            >
              <span class="link-name">{link.name}</span>
              <svg
                class="external-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                <polyline points="15 3 21 3 21 9" />
                <line x1="10" y1="14" x2="21" y2="3" />
              </svg>
            </a>
          ))
        }
      </div>
    </section>
  </div>
</Layout>

<style>
  .hero {
    text-align: center;
    margin-bottom: 4rem;
  }

  :global(.container.no-sidebar) {
    max-width: 566px;
  }

  p {
    margin: 0;
  }

  h1 {
    font-family: var(--font-code);
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
  }

  .profile-container {
    display: flex;
    gap: 1rem;
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 1.5rem 4rem;
  }

  /* 左カラム */
  .profile-left-column {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .profile-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    background-color: var(--background-surface);
    padding: 1.5rem;
    border-radius: 2px;
  }

  .profile-avatar {
    width: 54px;
    height: 54px;
    flex-shrink: 0;
  }

  .display-name {
    margin-top: 0;
    margin-bottom: 0.15rem;
    color: var(--text-normal);
    border-bottom: none;
    padding: 0;
  }

  .bio-short {
    font-size: 0.9rem;
    color: var(--ui-muted);
  }

  .bio-short a {
    color: inherit;
    text-decoration: none;
  }

  .bio-short a:hover {
    text-decoration: underline;
    color: var(--text-accent);
  }

  .self-introduction {
    background-color: var(--background-surface);
    padding: 1.5rem;
    border-radius: 2px;
    flex-grow: 1;
  }

  .intro-content {
    line-height: 1.8;
    color: var(--text-normal);
  }

  /* 右カラム */
  .profile-links {
    flex: 0.75;
  }

  .link-grid {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .link-button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 1rem;
    background-color: var(--background-surface);
    border-left: 2px solid var(--accent-color, #2d3038);
    border-radius: 2px;
    text-decoration: none !important;
    color: var(--text-normal) !important;
  }

  .link-button:hover {
    background-color: var(--background-accent-light);
    border-color: var(--accent-color, var(--text-accent));
    transform: translateX(4px);
  }

  .external-icon {
    width: 1rem;
    height: 1rem;
    opacity: 0.5;
  }

  .link-button:hover .external-icon {
    opacity: 1;
    color: var(--accent-color, var(--text-accent));
  }

  /* レスポンシブ */
  @media (max-width: 900px) {
    .profile-container {
      flex-direction: column;
      gap: 2rem;
    }

    .profile-left-column,
    .profile-links {
      flex: none;
      width: 100%;
    }

    .profile-card {
      padding: 1.5rem;
      flex-direction: column;
      text-align: center;
      justify-content: center;
    }

    .self-introduction {
      padding: 1.5rem;
      text-align: center;
    }
  }
</style>

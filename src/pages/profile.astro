---
import { client } from "../lib/microcms";
import Layout from "../layouts/Layout.astro";
import type { Page } from "../lib/microcms";
import { renderToc } from "../lib/toc";

// 1. "pages" エンドポイントから type が general かつスラッグが "profile" のデータを取得
const response = await client.get({ 
  endpoint: "pages", 
  queries: { filters: `type[contains]general[and]slug[equals]profile` } 
});

// 2. 取得したデータを取り出す
const page = response.contents[0] as Page;

// TOC生成も含めて呼び出す
const { toc, contentWithIds } = renderToc(page.content);
---

{/* 3. Layoutコンポーネントに取得したタイトルを渡し、中身を流し込む */}
<Layout title={page.title}>
  <h1>{page.title}</h1>

  {toc && toc.length > 0 && (
    <nav class="page-toc">
      <div class="toc-title">Contents</div>
      <ul class="nav-group toc-list">
        {toc.map(h2 => (
          <li>
            {h2.children.length > 0 ? (
              <details open>
                <summary>
                  <a href={`#${h2.id}`}>{h2.text}</a>
                </summary>
                <ul>
                  {h2.children.map(h3 => (
                    <li>
                      <a href={`#${h3.id}`}>{h3.text}</a>
                      {h3.children.length > 0 && (
                        <ul class="toc-sub">
                          {h3.children.map(h4 => (
                            <li><a href={`#${h4.id}`}>{h4.text}</a></li>
                          ))}
                        </ul>
                      )}
                    </li>
                  ))}
                </ul>
              </details>
            ) : (
              <a href={`#${h2.id}`}>{h2.text}</a>
            )}
          </li>
        ))}
      </ul>
    </nav>
  )}

  {/* リッチエディタの内容（本文）を表示 [1] */}
  <article set:html={contentWithIds} />
</Layout>
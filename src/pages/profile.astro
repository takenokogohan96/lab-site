---
import { client } from "../lib/microcms";
import Layout from "../layouts/Layout.astro";
import type { Page } from "../lib/microcms";
import { renderToc } from "../lib/toc";

// 1. "pages" エンドポイントから type が general かつスラッグが "profile" のデータを取得
const response = await client.get({
  endpoint: "pages",
  queries: { filters: `type[contains]general[and]slug[equals]profile` },
});

// 2. 取得したデータを取り出す
const page = response.contents[0] as Page;

// TOC生成も含めて呼び出す
const { toc, contentWithIds } = await renderToc(page.content);
---

{/* 3. Layoutコンポーネントに取得したタイトルを渡し、中身を流し込む */}
<Layout title={page.title} description={page.description}>
  <header class="article-header" slot="header">
    <h1>{page.title}</h1>
  </header>
  {/* リッチエディタの内容（本文）を表示 [1] */}
  <article set:html={contentWithIds} />

  <footer class="article-footer">
    <div class="article-meta-footer">
      <a href="/" class="back-to-top">← トップへ戻る</a>
      {
        page.type.includes("repo") ? (
          (page.published || page.publishedAt) && (
            <time datetime={page.published || page.publishedAt}>
              公開日:{" "}
              {new Date(page.published || page.publishedAt).toLocaleDateString(
                "ja-JP",
                { year: "numeric", month: "2-digit", day: "2-digit" },
              )}
            </time>
          )
        ) : (
          <time datetime={page.updatedAt}>
            更新日:{" "}
            {new Date(page.updatedAt).toLocaleDateString("ja-JP", {
              year: "numeric",
              month: "2-digit",
              day: "2-digit",
            })}
          </time>
        )
      }
    </div>
  </footer>
</Layout>

---
import { client, formatColor, REPOSITORY_QUERY_FILTER } from "../lib/microcms";
import type { Page } from "../lib/microcms";
import Layout from "../layouts/Layout.astro";
import { renderToc } from "../lib/toc";

export async function getStaticPaths() {
  // data と repo の両方のタイプを含めて全件取得
  const response = await client.get({ 
    endpoint: "pages",
    queries: { 
      filters: REPOSITORY_QUERY_FILTER,
      limit: 100,
    }
  });
  
  return response.contents.map((page: Page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

interface Props {
  page: Page;
}

const { page } = Astro.props;

// 万が一データが取得できなかった場合の安全策
if (!page) {
  return Astro.redirect('/404');
}

const { toc, contentWithIds } = await renderToc(page.content);
---
<Layout title={page.title} description={page.description} toc={toc} page={page}>
  <header class="article-header" slot="header">
    <div class="meta-info">
      {page.category && (
        <span 
          class="category-label" 
          style={page.category.color ? { 
            borderColor: formatColor(page.category.color), 
            color: '#fff' 
          } : {}}
        >
          {page.category.name}
        </span>
      )}
    </div>
    <h1>{page.title}</h1>
    {page.description && <p class="description">{page.description}</p>}
  </header>

  <article set:html={contentWithIds} />

  <footer class="article-footer">
    <div class="article-meta-footer">
      <a href="/" class="back-to-top">← トップへ戻る</a>
      {page.type.includes('repo') ? (
        page.published && (
          <time datetime={page.published}>
            公開日: {new Date(page.published).toLocaleDateString('ja-JP', { year: 'numeric', month: '2-digit', day: '2-digit', timeZone: 'Asia/Tokyo' })}
          </time>
        )
      ) : (
        <time datetime={page.updatedAt}>
          更新日: {new Date(page.updatedAt).toLocaleDateString('ja-JP', { year: 'numeric', month: '2-digit', day: '2-digit', timeZone: 'Asia/Tokyo' })}
        </time>
      )}
    </div>
  </footer>
</Layout>

---
import { client, formatColor, REPOSITORY_QUERY_FILTER } from "../lib/microcms";
import type { Page } from "../lib/microcms";
import Layout from "../layouts/Layout.astro";
import { renderToc } from "../lib/toc";

export async function getStaticPaths() {
  // data と repo の両方のタイプを含めて全件取得
  const response = await client.get({ 
    endpoint: "pages",
    queries: { 
      filters: REPOSITORY_QUERY_FILTER,
      limit: 100,
    }
  });
  
  return response.contents.map((page: Page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

interface Props {
  page: Page;
}

const { page } = Astro.props;

// 万が一データが取得できなかった場合の安全策
if (!page) {
  return Astro.redirect('/404');
}

const { toc, contentWithIds } = renderToc(page.content);
---
<Layout title={page.title}>
  <div class="meta-info">
    {page.category && (
      <span 
        class="category-label" 
        style={page.category.color ? { 
          borderColor: formatColor(page.category.color), 
          color: '#fff' 
        } : {}}
      >
        {page.category.name}
      </span>
    )}
    {page.published && <span class="date">公開日: {new Date(page.published).toLocaleDateString('ja-JP')}</span>}
  </div>
  <h1>{page.title}</h1>

  {toc && toc.length > 0 && (
    <nav class="page-toc">
      <div class="toc-title">Contents</div>
      <ul class="nav-group toc-list">
        {toc.map(h2 => (
          <li>
            {h2.children.length > 0 ? (
              <details open>
                <summary>
                  <a href={`#${h2.id}`}>{h2.text}</a>
                </summary>
                <ul>
                  {h2.children.map(h3 => (
                    <li>
                      <a href={`#${h3.id}`}>{h3.text}</a>
                      {h3.children.length > 0 && (
                        <ul class="toc-sub">
                          {h3.children.map(h4 => (
                            <li><a href={`#${h4.id}`}>{h4.text}</a></li>
                          ))}
                        </ul>
                      )}
                    </li>
                  ))}
                </ul>
              </details>
            ) : (
              <a href={`#${h2.id}`}>{h2.text}</a>
            )}
          </li>
        ))}
      </ul>
    </nav>
  )}

  <article set:html={contentWithIds} />
</Layout>

<style>
  .meta-info {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.5rem;
    font-size: 0.9rem;
    color: #9ca3af;
  }
</style>